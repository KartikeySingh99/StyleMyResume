# Appwrite — copy to .env and fill in from your Appwrite console.
# Use the endpoint shown under Settings -> API Endpoint *verbatim*. Cloud
# projects live on regional hosts (e.g. https://fra.cloud.appwrite.io/v1);
# the bare cloud.appwrite.io host will fail to resolve the project.
VITE_APPWRITE_URL=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_COLLECTION_ID=

# ID of the deployed `functions/ai-suggestions` function.
# Leave blank to disable the AI suggestions panel.
VITE_APPWRITE_AI_FUNCTION_ID=

# NOTE: never put an OpenAI key here. Anything prefixed with VITE_ is inlined
# into the public JS bundle. The key lives as a function variable on
# `functions/ai-suggestions` instead — see that folder's README.
