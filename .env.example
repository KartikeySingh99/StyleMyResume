# ---------------------------------------------------------------------------
# Web app (Vite). Copy to .env and fill in from your Appwrite console.
#
# Use the endpoint shown under Settings -> API Endpoint *verbatim*. Cloud
# projects may live on regional hosts (e.g. https://fra.cloud.appwrite.io/v1).
#
# Everything VITE_-prefixed is inlined into the PUBLIC bundle. Never put a
# secret here.
# ---------------------------------------------------------------------------
VITE_APPWRITE_URL=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_COLLECTION_ID=

# ---------------------------------------------------------------------------
# Netlify function (netlify/functions/ai-suggestions.mjs).
#
# Not VITE_-prefixed, so it never reaches the browser. Set it in
# Netlify -> Site settings -> Environment variables, marked as a secret value.
# Listed here only so `netlify dev` can serve the function locally.
#
# The function reuses VITE_APPWRITE_URL / VITE_APPWRITE_PROJECT_ID above to
# verify callers — Netlify passes all site variables to functions, so there is
# no need to duplicate them. APPWRITE_ENDPOINT / APPWRITE_PROJECT_ID override
# them if you ever need the function pointed somewhere else.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=            # from https://aistudio.google.com/apikey
# GEMINI_MODEL=              # optional, defaults to gemini-2.5-flash
